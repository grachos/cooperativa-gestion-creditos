NODE_ENV=development
PORT=4000

# Producción / Supabase: una sola cadena de conexión Postgres.
# Usa el connection string del "Transaction pooler" (puerto 6543) de Supabase.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# Desarrollo local sin Supabase (docker compose up -d levanta este Postgres):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cooperativa_creditos

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=12h

CORS_ORIGIN=http://localhost:5173
TIMEZONE=America/Bogota
CURRENCY=COP

# URL pública del frontend, usada para armar el enlace de "restablecer
# contraseña" dentro del correo que se envía al usuario.
APP_URL=http://localhost:5173

# Envío de correo (restablecer contraseña). Sin SMTP_HOST, el enlace de
# restablecimiento se registra en la consola del backend en vez de
# enviarse por correo — útil en desarrollo, no usar así en producción.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicación
# SMTP_FROM="Coomulnissi <no-reply@coomulnissi.com>"

# Job diario de mora/alertas (Vercel Cron → GET /api/v1/alerts/cron). Vercel
# envía "Authorization: Bearer <CRON_SECRET>". Sin definirlo, el job responde
# 401 y no se ejecuta. Mínimo 16 caracteres aleatorios.
# CRON_SECRET=

# Idempotency-Key (evita duplicados por doble clic / reintentos de red).
# El proyecto no tenía una convención de vigencia para esto; por defecto 24 h.
# Admite decimales (0.5 = 30 min). Máximo 720 (30 días).
# IDEMPOTENCY_TTL_HOURS=24
# Cuánto espera una petición duplicada a que termine la original antes de
# recibir 409 IDEMPOTENCY_IN_PROGRESS (milisegundos).
# IDEMPOTENCY_WAIT_MS=8000

# Límite de peticiones de autenticación por IP cada 15 min (login, forgot-password,
# reset-password). Por defecto 40. Súbalo SOLO en un entorno de pruebas de carga.
# AUTH_RATE_LIMIT=40

# Pool de conexiones MySQL POR PROCESO (procesos × DB_POOL_SIZE no debe superar el
# max_user_connections del plan de hosting). DB_QUEUE_LIMIT: cuántas peticiones pueden
# esperar una conexión libre; pasado eso se responde 503.
# DB_POOL_SIZE=10
# DB_QUEUE_LIMIT=200
# DB_CONNECT_TIMEOUT_MS=10000
# Tiempo máximo para recibir una petición completa (ms).
# REQUEST_TIMEOUT_MS=60000

# Caché de reportes pesados (segundos; 0 = no guardar, la coalescencia de peticiones simultáneas sigue).
# REPORT_CACHE_TTL_SECONDS=60
# Registro de peticiones: slow (solo 5xx y lentas, por defecto) | all (todas; depurar) | off.
# REQUEST_LOG=slow
# SLOW_REQUEST_MS=1000
# SLOW_QUERY_MS=500

# --- Cloudflare Turnstile (anti-bots en login, recuperar y restablecer contraseña) ---
# Cree el sitio en Cloudflare (Turnstile → Add site, modo Managed) y copie las dos claves.
# La SITE KEY es pública; la SECRET KEY nunca va en el repositorio ni en el frontend.
# En DESARROLLO use las claves de prueba oficiales (siempre pasa); en producción se rechazan:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# (siempre falla: 2x00000000000000000000AB / 2x0000000000000000000000000000000AA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Dominios propios que Cloudflare debe reportar (separados por coma, sin https://).
TURNSTILE_ALLOWED_HOSTNAMES=coomulnissi.cc,www.coomulnissi.cc
# true = se exige el reto (falla cerrado). Déjelo en true en producción.
TURNSTILE_ENFORCE=true
