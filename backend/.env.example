NODE_ENV=development
PORT=4000

# Producción / Supabase: una sola cadena de conexión Postgres.
# Usa el connection string del "Transaction pooler" (puerto 6543) de Supabase.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# Desarrollo local sin Supabase (docker compose up -d levanta este Postgres):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cooperativa_creditos

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
TIMEZONE=America/Bogota
CURRENCY=COP
